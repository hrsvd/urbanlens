NEXT_PUBLIC_APP_URL=http://localhost:3000
MAP_DATA_MODE=local
GRID_SIZE_METERS=100
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# CPCB real-time AQI (optional but strongly recommended for production).
# Register a free API key at https://data.gov.in and set it here to use
# real CPCB/KSPCB monitoring station PM2.5 data instead of the 45 km CAMS
# atmospheric model. When set, the nearest Bengaluru station is used and
# confidence rises from 0.55 (CAMS) to 0.72 (monitoring station).
CPCB_API_KEY=
